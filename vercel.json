{
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.gitfekra.com" }],
      "destination": "https://gitfekra.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.mrmohamedabdella.com" }],
      "destination": "https://mrmohamedabdella.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.mrkhalidelsharif.com" }],
      "destination": "https://mrkhalidelsharif.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "(www\\.)?gitfekra\\.com" }],
      "destination": "/sitemap-gitfekra.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "(www\\.)?mrkhalidelsharif\\.com" }],
      "destination": "/sitemap-eldad.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "(www\\.)?mrmohamedabdella\\.com" }],
      "destination": "/sitemap-mohamed-abdella.xml"
    },
    { "source": "/sitemap.xml", "destination": "/sitemap-default.xml" },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "(www\\.)?gitfekra\\.com" }],
      "destination": "/robots-gitfekra.txt"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "(www\\.)?mrkhalidelsharif\\.com" }],
      "destination": "/robots-eldad.txt"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "(www\\.)?mrmohamedabdella\\.com" }],
      "destination": "/robots-mohamed-abdella.txt"
    },
    { "source": "/robots.txt", "destination": "/robots-default.txt" },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(www\\.)?mrkhalidelsharif\\.com" }],
      "destination": "/eldad.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(www\\.)?mrmohamedabdella\\.com" }],
      "destination": "/mohamed-abdella.html"
    },
    { "source": "/(.*)", "destination": "/default.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}

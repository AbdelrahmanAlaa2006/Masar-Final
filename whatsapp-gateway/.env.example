# ── Required ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key (Supabase Dashboard → Project Settings → API → service_role).
# KEEP THIS SECRET — it is only ever used on this server, never in the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Optional ─────────────────────────────────────────────────────────────────
PORT=8790
COUNTRY_CODE=20
# Anti-ban pacing + daily cap (per tenant)
MIN_DELAY_SECONDS=25
MAX_DELAY_SECONDS=60
DAILY_LIMIT=300
# How often the worker checks each connected tenant's queue (seconds)
WORKER_SECONDS=20

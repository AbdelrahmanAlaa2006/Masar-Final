# ── Required: the tenant admin's platform login ─────────────────────────────
# This scopes the sender to that tenant automatically (multi-tenant safe).
# The email is the admin's phone-based login, e.g. 01099999999@masaar.app
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Optional (defaults shown) ────────────────────────────────────────────────
# SUPABASE_URL / SUPABASE_ANON_KEY are read from the project's ../.env
# automatically — only set them here if this folder is deployed alone.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Country code for local phone numbers (Egypt = 20)
# COUNTRY_CODE=20

# Anti-ban pacing: random wait between messages (seconds) and daily cap
# MIN_DELAY_SECONDS=25
# MAX_DELAY_SECONDS=60
# DAILY_LIMIT=200

# How often to check for new pending messages (seconds)
# POLL_SECONDS=60
